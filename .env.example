# =============================================================================
# VOLTAGE CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Core Configuration
# -----------------------------------------------------------------------------
VOLTAGE_NAME=VOLTAGE
VOLTAGE_VERSION=1.1.0
VOLTAGE_ENV=local
VOLTAGE_PROTOCOL=http
VOLTAGE_HOST=localhost
VOLTAGE_PORT=8080
VOLTAGE_NGINX_PORT=8080
VOLTAGE_PATH=/
VOLTAGE_TIMEZONE=UTC
VOLTAGE_TEMP_DIR=./storage/tmp

# -----------------------------------------------------------------------------
# FFMPEG Configuration
# -----------------------------------------------------------------------------
VOLTAGE_UTILS_FFMPEG_PATH=ffmpeg
VOLTAGE_UTILS_FFMPEG_THREADS=
VOLTAGE_UTILS_FFMPEG_PRESET=DEFAULT
VOLTAGE_UTILS_FFMPEG_QUALITY=
VOLTAGE_UTILS_FFMPEG_BIT_RATE_MIN=
VOLTAGE_UTILS_FFMPEG_BIT_RATE_MAX=
VOLTAGE_UTILS_FFPROBE_PATH=ffprobe
VOLTAGE_UTILS_FFPROBE_GENERAL_ATTRIBUTES=
VOLTAGE_UTILS_FFPROBE_VIDEO_ATTRIBUTES=
VOLTAGE_UTILS_FFPROBE_AUDIO_ATTRIBUTES=

# -----------------------------------------------------------------------------
# NSFW Detection
# -----------------------------------------------------------------------------
VOLTAGE_UTILS_NSFW_MODEL=MOBILE_NET_V2
VOLTAGE_UTILS_NSFW_SIZE=224
VOLTAGE_UTILS_NSFW_TYPE=GRAPH
VOLTAGE_UTILS_NSFW_THRESHOLD=70

# -----------------------------------------------------------------------------
# Whisper Transcription
# -----------------------------------------------------------------------------
VOLTAGE_UTILS_WHISPER_MODEL=BASE
VOLTAGE_UTILS_WHISPER_WITH_CUDA=false

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Types: LOCAL, AWS_S3, GOOGLE_CLOUD_STORAGE, DO_SPACES, LINODE, WASABI, 
#        BACKBLAZE, RACKSPACE, MICROSOFT_AZURE, OTHER_S3, FTP, SFTP
VOLTAGE_STORAGE_TYPE=LOCAL
VOLTAGE_STORAGE_ENDPOINT=
VOLTAGE_STORAGE_ACCESS_KEY=
VOLTAGE_STORAGE_ACCESS_SECRET=
VOLTAGE_STORAGE_REGION=
VOLTAGE_STORAGE_BUCKET=
VOLTAGE_STORAGE_FORCE_PATH_STYLE=false
VOLTAGE_STORAGE_ACL=PUBLIC_READ
VOLTAGE_STORAGE_EXPIRES_IN=
VOLTAGE_STORAGE_CACHE_CONTROL=
VOLTAGE_STORAGE_HOST=
VOLTAGE_STORAGE_USERNAME=
VOLTAGE_STORAGE_PASSWORD=
VOLTAGE_STORAGE_SECURE=false
VOLTAGE_STORAGE_BASE_PATH=./storage
VOLTAGE_STORAGE_PUBLIC_URL_BASE=

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Types: SQLITE, MYSQL, MARIADB, POSTGRESQL, MSSQL, AWS_REDSHIFT, COCKROACHDB
VOLTAGE_DATABASE_TYPE=SQLITE
VOLTAGE_DATABASE_HOST=localhost
VOLTAGE_DATABASE_PORT=3306
VOLTAGE_DATABASE_USERNAME=root
VOLTAGE_DATABASE_PASSWORD=
VOLTAGE_DATABASE_NAME=voltage
VOLTAGE_DATABASE_TABLE_PREFIX=
VOLTAGE_DATABASE_FILE_NAME=db.sqlite
VOLTAGE_DATABASE_CLEANUP_INTERVAL=3600000

# -----------------------------------------------------------------------------
# Runtime Configuration
# -----------------------------------------------------------------------------
VOLTAGE_RUNTIME_IS_DISABLED=false
VOLTAGE_INSTANCES_KEY_METHOD=IP_ADDRESS
VOLTAGE_INSTANCES_MAINTAIN_INTERVAL=10000
VOLTAGE_INSTANCES_ONLINE_TIMEOUT=15000
VOLTAGE_INSTANCES_PURGE_AFTER=60000
VOLTAGE_WORKERS_PER_CPU_CORE=1
VOLTAGE_WORKERS_BUSY_INTERVAL=1000
VOLTAGE_WORKERS_BUSY_TIMEOUT=300000
VOLTAGE_WORKERS_IDLE_AFTER=10000

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
VOLTAGE_API_IS_DISABLED=false
VOLTAGE_API_NODE_PORT=4000
VOLTAGE_API_KEY=
VOLTAGE_API_REQUEST_BODY_LIMIT=0
VOLTAGE_API_SENSITIVE_FIELDS=password,access_secret
VOLTAGE_API_AUTH_RATE_LIMIT_WINDOW_MS=900000
VOLTAGE_API_AUTH_RATE_LIMIT_MAX_REQUESTS=5

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
VOLTAGE_FRONTEND_IS_DISABLED=false
VOLTAGE_FRONTEND_NODE_PORT=3000
VOLTAGE_FRONTEND_PASSWORD=
VOLTAGE_FRONTEND_DATA_REFETCH_INTERVAL=10000
VOLTAGE_FRONTEND_DATETIME_FORMAT=YYYY-MM-DD HH:mm:ss
VOLTAGE_FRONTEND_LOCAL_STORAGE_PREFIX=voltage

# -----------------------------------------------------------------------------
# Statistics & Logs
# -----------------------------------------------------------------------------
VOLTAGE_STATS_RETENTION=31536000000
VOLTAGE_LOGS_IS_DISABLED=false
VOLTAGE_LOGS_RETENTION=3600000

# -----------------------------------------------------------------------------
# Jobs Configuration
# -----------------------------------------------------------------------------
VOLTAGE_JOBS_QUEUE_TIMEOUT=300000
VOLTAGE_JOBS_PROCESS_INTERVAL=1000
VOLTAGE_JOBS_PROCESS_TIMEOUT=1800000
VOLTAGE_JOBS_ENQUEUE_ON_RECEIVE=true
VOLTAGE_JOBS_ENQUEUE_LIMIT=10
VOLTAGE_JOBS_RETENTION=86400000
VOLTAGE_JOBS_INPUT_ANALYSIS=true
VOLTAGE_JOBS_PREVIEW_GENERATION=true
VOLTAGE_JOBS_NSFW_DETECTION=false
VOLTAGE_JOBS_PRIORITY=1000
VOLTAGE_JOBS_TRY=3
VOLTAGE_JOBS_TRY_MIN=1
VOLTAGE_JOBS_TRY_MAX=3
VOLTAGE_JOBS_RETRY_IN=60000
VOLTAGE_JOBS_RETRY_IN_MIN=60000
VOLTAGE_JOBS_RETRY_IN_MAX=3600000
VOLTAGE_JOBS_PREVIEW_FORMAT=PNG
VOLTAGE_JOBS_PREVIEW_QUALITY=75
VOLTAGE_JOBS_OUTPUTS_PROCESS_INTERVAL=10000

# -----------------------------------------------------------------------------
# Notifications Configuration
# -----------------------------------------------------------------------------
VOLTAGE_JOB_NOTIFICATIONS_PROCESS_INTERVAL=1000
VOLTAGE_JOB_NOTIFICATIONS_PROCESS_LIMIT=10
VOLTAGE_JOB_NOTIFICATIONS_NOTIFY_ON=RECEIVED,COMPLETED,FAILED,TIMEOUT
VOLTAGE_JOB_NOTIFICATIONS_NOTIFY_ON_ALLOWEDS=RECEIVED,PENDING,RETRYING,QUEUED,PROCESSING,COMPLETED,FAILED,TIMEOUT,CANCELLED
VOLTAGE_JOB_NOTIFICATIONS_TIMEOUT=10000
VOLTAGE_JOB_NOTIFICATIONS_TIMEOUT_MAX=30000
VOLTAGE_JOB_NOTIFICATIONS_TRY=3
VOLTAGE_JOB_NOTIFICATIONS_TRY_MIN=1
VOLTAGE_JOB_NOTIFICATIONS_TRY_MAX=3
VOLTAGE_JOB_NOTIFICATIONS_RETRY_IN=60000
VOLTAGE_JOB_NOTIFICATIONS_RETRY_IN_MIN=60000
VOLTAGE_JOB_NOTIFICATIONS_RETRY_IN_MAX=3600000
